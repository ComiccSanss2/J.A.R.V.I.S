# =============================================================
#  J.A.R.V.I.S. OS — configuration  (copy to .env and fill in)
# =============================================================

# ---- Claude (required) ----
ANTHROPIC_API_KEY=
# claude-haiku-5-5 = cheapest and fastest (about 0.05 cents per exchange)
# claude-sonnet-5-5 = smarter | claude-opus-5-5 = smartest (about 2 cents per exchange)
JARVIS_MODEL=claude-haiku-5-5
# Reasoning depth: low = fast spoken replies | medium | high
JARVIS_EFFORT=low
JARVIS_MAX_TOKENS=16000
# Messages of history sent to Claude on every turn
JARVIS_HISTORY_LIMIT=40
# Anthropic-side web search (must be enabled in your organisation's Console)
JARVIS_WEB_SEARCH=true

# ---- Developer tools: J.A.R.V.I.S. can create files, write code and use the terminal ----
JARVIS_DEV_TOOLS=true
# Folder where files are created (empty = JARVIS-Workspace in your home folder)
JARVIS_WORKSPACE=
# true = every terminal command must be approved on screen (strongly recommended)
JARVIS_CONFIRM_COMMANDS=true

# ---- Personalisation ----
# Language mode at first start: en (English only) | it (full Italian) | fr (full French).
# You can switch any time with the EN / IT buttons in the HUD; the choice is remembered.
JARVIS_LANGUAGE=en
# How J.A.R.V.I.S. addresses you in English / Italian mode
JARVIS_USER_TITLE=Sir
JARVIS_USER_TITLE_IT=Signore
JARVIS_TIMEZONE=Europe/Rome
JARVIS_CITY=Rome

# ---- Server ----
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765
# true = self-signed HTTPS (needed for the microphone on a second device on the LAN)
JARVIS_SSL=false
# Shared token: if set, clients must open  https://IP:8765/?token=...
JARVIS_ACCESS_TOKEN=

# =============================================================
#  VOICE TONE  — change these to make J.A.R.V.I.S. sound different
#  (restart the server after every change)
# =============================================================
# Which engine speaks: auto = ElevenLabs -> OpenAI -> edge-tts (free) -> browser voice
# Values: auto | elevenlabs | openai | edge | browser
TTS_PROVIDER=auto

# ---- Free voice (edge-tts, no key needed) ----
# British male: en-GB-RyanNeural (default) | en-GB-ThomasNeural
# Others: en-GB-SoniaNeural (female) | en-US-AndrewMultilingualNeural | en-US-BrianMultilingualNeural
EDGE_TTS_VOICE=en-GB-RyanNeural
# Speed: -10% = slower and calmer, +10% = quicker
EDGE_TTS_RATE=-4%
# Pitch: negative = deeper (-2Hz to -6Hz sounds natural; below -10Hz sounds robotic)
EDGE_TTS_PITCH=-3Hz
EDGE_TTS_VOLUME=+0%
# Italian mode voice: it-IT-DiegoNeural (male) | it-IT-GiuseppeMultilingualNeural (male, warmer)
#                     it-IT-ElsaNeural | it-IT-IsabellaNeural (female)
EDGE_TTS_VOICE_IT=it-IT-DiegoNeural
EDGE_TTS_RATE_IT=+0%
EDGE_TTS_PITCH_IT=-2Hz

# ---- ElevenLabs (most realistic; free plan available) ----
ELEVENLABS_API_KEY=
# Voice ID from elevenlabs.io > Voices (default "George": warm British male)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
# Stability 0-1: lower = more expressive/human, higher = steadier/flatter
ELEVENLABS_STABILITY=0.45
# Similarity 0-1: how closely it sticks to the original voice
ELEVENLABS_SIMILARITY=0.8
# Style 0-1: higher = more dramatic delivery (0.1-0.3 suits a butler)
ELEVENLABS_STYLE=0.2
# Speed 0.7-1.2
ELEVENLABS_SPEED=1.0

# ---- OpenAI TTS (paid) ----
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voices: ash | onyx | echo | fable | sage | ballad | verse | alloy | coral | nova | shimmer
OPENAI_TTS_VOICE=ash
# Describe the tone in plain words
OPENAI_TTS_INSTRUCTIONS=Refined British butler. Calm, warm, quietly confident, with dry understated wit. Natural pace, light pauses between sentences, never theatrical.

# ---- Speech recognition (STT) ----
# auto = Deepgram/OpenAI if a key is set, otherwise the browser's Web Speech API (Chrome/Edge)
# Values: auto | browser | openai | deepgram | local  (local = offline faster-whisper)
STT_PROVIDER=auto
OPENAI_STT_MODEL=whisper-1
DEEPGRAM_API_KEY=
LOCAL_WHISPER_MODEL=small

# ---- Integrations (used in config/integrations.json as ${VAR}) ----
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
CALENDAR_WEBHOOK_URL=

# ---- Wake word & interruption ----
# true = mic always on, but J.A.R.V.I.S. only answers phrases that start with "Hey Jarvis"
JARVIS_WAKE_WORD=true
# seconds after an answer to follow up without saying "Hey Jarvis" (0 = always say it)
JARVIS_FOLLOWUP_SECONDS=0
# true = say "Hey Jarvis, ..." while he talks to cut him off with a new request
JARVIS_BARGE_IN=true

# ---- French mode (switch with EN / IT / FR in the HUD) ----
JARVIS_USER_TITLE_FR=Monsieur
# fr-FR-HenriNeural (male) | fr-FR-RemyMultilingualNeural (male, warmer) | fr-FR-DeniseNeural | fr-FR-EloiseNeural (female)
EDGE_TTS_VOICE_FR=fr-FR-HenriNeural
EDGE_TTS_RATE_FR=+0%
EDGE_TTS_PITCH_FR=-2Hz

# ---- Music ----
# app = open YouTube Music in its desktop app (installed from Brave/Chrome/Edge) | browser = in the browser
JARVIS_MUSIC_PLAYER=app
# false = music starts minimized in the background, the window doesn't pop up | true = bring it to the front
JARVIS_MUSIC_FOREGROUND=false
# Path of the YouTube Music shortcut (.lnk) if it is not found automatically
JARVIS_YTMUSIC_SHORTCUT=

# ---- Web browsing: J.A.R.V.I.S. opens, reads, sees and clicks web pages in his own browser window ----
JARVIS_WEB_BROWSING=true
# msedge | chrome | empty = Edge first, then Chrome
JARVIS_WEB_BROWSER=
